# CineRoom Environment Variables Example

# Toggle whether mock services are used for local testing and MVP demo
# Set to true only for local sandboxed testing (no remote server connection)
VITE_USE_MOCK_SERVICES=false

# Supabase Realtime Backend Integration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-anon-key-here

# WebRTC ICE Servers Configuration (STUN / TURN)
VITE_ICE_SERVERS=[{"urls":"stun:stun1.l.google.com:19302"},{"urls":"stun:stun2.l.google.com:19302"}]
